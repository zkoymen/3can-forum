# Copy to .env.local for dev or set as Vercel env vars for production.
# NEVER commit a real .env file.

# Pinata JWT — generated at https://app.pinata.cloud → API Keys
VITE_PINATA_JWT=

# Optional gateway override; defaults to https://gateway.pinata.cloud
VITE_PINATA_GATEWAY=https://gateway.pinata.cloud

# STRONGLY recommended: a dedicated Sepolia RPC (Alchemy or Infura free tier).
# The shared public nodes rate-limit aggressively, which causes the
# "could not coalesce error" / "thread not found" flakiness. A dedicated URL
# makes reads reliable and fast. Leave blank to fall back to public nodes.
#   Alchemy:  https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
#   Infura:   https://sepolia.infura.io/v3/YOUR_KEY
VITE_SEPOLIA_RPC_URL=
